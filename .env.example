# Copy this file to .env for local development. Never commit .env.
# PostgreSQL connection string; replace placeholders after PostgreSQL is configured.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/habit_heatmap?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different value in every environment. Do not expose it to the browser.
BETTER_AUTH_SECRET=""

# The application origin used by Better Auth during local development.
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
